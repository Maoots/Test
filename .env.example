# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── imgbb (image hosting) ─────────────────────────────────────────────────────
# Free account + API key at https://api.imgbb.com
IMGBB_API_KEY=...

# ── Instagram Graph API ───────────────────────────────────────────────────────
# Follow SETUP.md to get these two values
INSTAGRAM_USER_ID=...
INSTAGRAM_ACCESS_TOKEN=...

# ── Scheduler settings ────────────────────────────────────────────────────────
# Time to post each day (24h format, server local time)
POST_TIME=09:00
# See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Europe/Paris

# ── Storage ───────────────────────────────────────────────────────────────────
LOG_FILE=posts_log.json
IMAGES_DIR=generated_images
