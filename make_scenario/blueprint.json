{
  "name": "Garden Photo Instagram Bot",
  "flow": [
    {
      "id": 1,
      "module": "openai-gpt-3:GenerateImage",
      "version": 1,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "model": "dall-e-3",
        "prompt": "A beautiful, vibrant garden with colorful flowers, lush greenery, and natural lighting. Photorealistic, high quality.",
        "n": "1",
        "size": "1024x1024",
        "quality": "standard"
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "instagram-business:CreatePostPhoto",
      "version": 1,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "accountId": "",
        "image_url": "{{1.url}}",
        "caption": "🌿 Daily Garden Inspiration 🌿\n\n#garden #nature #plants #gardening #flowers #greenery #botanical #outdoors #naturephotography #gardenlife"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    }
  }
}
